<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.conload</groupId>
  <artifactId>conload</artifactId>
  <name>Copilot Context Loader</name>
  <version>1.0.0</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <source>21</source>
          <target>21</target>
          <encoding>UTF-8</encoding>
          <compilerArgs>
            <arg>--add-reads=com.conload=ALL-UNNAMED</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.conload.App</mainClass>
          <launcher>conload</launcher>
          <options>
            <option>--add-reads=com.conload=ALL-UNNAMED</option>
          </options>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>conload-${project.version}${platform.suffix}</finalName>
              <transformers>
                <transformer>
                  <mainClass>com.conload.Launcher</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.openjfx:*</artifact>
                  <excludes>
                    <exclude>${javafx.exclude1}</exclude>
                    <exclude>${javafx.exclude2}</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>copy-deps</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/libs</outputDirectory>
                  <excludeGroupIds>org.openjfx</excludeGroupIds>
                  <includeScope>runtime</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.3.0</version>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <archive>
                <manifest>
                  <mainClass>com.conload.App</mainClass>
                </manifest>
              </archive>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>mac</id>
      <properties>
        <platform.suffix>-mac</platform.suffix>
      </properties>
    </profile>
    <profile>
      <id>linux</id>
      <properties>
        <javafx.classifier>linux</javafx.classifier>
        <javafx.exclude2>**/*.dll</javafx.exclude2>
        <javafx.exclude1>**/*.dylib</javafx.exclude1>
        <platform.suffix>-linux</platform.suffix>
      </properties>
    </profile>
    <profile>
      <id>windows</id>
      <properties>
        <javafx.classifier>win</javafx.classifier>
        <javafx.exclude2>**/*.so</javafx.exclude2>
        <javafx.exclude1>**/*.dylib</javafx.exclude1>
        <platform.suffix>-windows</platform.suffix>
      </properties>
    </profile>
  </profiles>
  <repositories>
    <repository>
      <releases />
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>jetbrains-intellij-dependencies</id>
      <url>https://packages.jetbrains.team/maven/p/ij/intellij-dependencies</url>
    </repository>
  </repositories>
  <properties>
    <maven.compiler.target>21</maven.compiler.target>
    <maven.compiler.source>21</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.2</javafx.version>
    <javafx.exclude2>__NOEXCLUDE__</javafx.exclude2>
    <javafx.exclude1>__NOEXCLUDE__</javafx.exclude1>
    <jackson.version>2.17.0</jackson.version>
    <app.name>conload</app.name>
    <app.version>1.0.0</app.version>
  </properties>
</project>
