# Template for the Homebrew formula in soft-am/homebrew-tap.
#
# The workflow in .github/workflows/update-formula.yml (triggered on
# release-published or manual run) substitutes the version and sha256
# placeholder tokens below and pushes the result as Formula/conload.rb to
# the public soft-am/homebrew-tap repository (via the HOMEBREW_TAP_TOKEN
# secret). The generated formula does NOT live in this repo — the tap repo
# is the single source of truth. Users install with:
#   brew install soft-am/tap/conload
class Conload < Formula
  desc "Context layer for CLI coding agents — Confluence/Jira/GitHub as Markdown"
  homepage "https://github.com/soft-am/conload"
  version "__VERSION__"
  license "Apache-2.0"
  depends_on "openjdk@21"

  on_macos do
    url "https://github.com/soft-am/conload/releases/download/v__VERSION__/conload-mac.jar"
    sha256 "__MAC_SHA__"
  end

  on_linux do
    url "https://github.com/soft-am/conload/releases/download/v__VERSION__/conload-linux.jar"
    sha256 "__LINUX_SHA__"
  end

  def install
    jar_name = Dir["conload-*.jar"].first
    libexec.install jar_name
    (bin/"conload").write <<~SH
      #!/bin/bash
      exec "#{Formula["openjdk@21"].opt_bin}/java" -jar "#{libexec}/#{jar_name}" "$@"
    SH
  end

  test do
    assert_predicate (bin/"conload"), :executable?
  end
end
